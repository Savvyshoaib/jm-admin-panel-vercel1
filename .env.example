# Browser API origin (no trailing slash). Network tab shows this host.
# Example: https://jm-backend.qiko.ai
VITE_API_BASE_URL=https://jm-backend.qiko.ai

# Extra CSP connect-src hosts (space-separated). Must include VITE_API_BASE_URL
# and any other browser fetch hosts (e.g. Land Registry for regions).
VITE_CSP_CONNECT_SRC=https://jm-backend.qiko.ai https://landregistry.data.gov.uk

# true = Vite proxies /admin + /storage to VITE_API_BASE_URL (local CORS bypass)
# false = browser calls VITE_API_BASE_URL directly
VITE_USE_API_PROXY=false

# true = local JSON mocks; false = live APIs
VITE_USE_MOCK_DATA=false
